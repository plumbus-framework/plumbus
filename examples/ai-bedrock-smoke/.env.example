# Copy to .env and fill in. `.env` is gitignored — never commit it.
# Erase / rotate keys when you are done testing.
#
# ══════════════════════════════════════════════════════════════════════
# Mode A — Bedrock Mantle (what the AWS console "OpenAI compatible" export gives you)
# Exercises: createOpenAIAdapter → https://bedrock-mantle.<region>.api.aws/v1
# Does NOT exercise @plumbus/ai-bedrock (that package uses Converse + IAM).
# ══════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
OPENAI_BASE_URL=https://bedrock-mantle.eu-north-1.api.aws/v1
# Optional model overrides. Mantle chat ids are family-style (e.g. qwen.qwen3-32b).
# Anthropic Claude ids on Mantle often reject /v1/chat/completions (Responses API only).
# AI_BEDROCK_MODEL=qwen.qwen3-32b
# AI_BEDROCK_EMBEDDING_MODEL=…   # only if /v1/models lists an embedding model
# OPENAI_MODEL=...
# Force mode: BEDROCK_SMOKE_MODE=mantle

# ══════════════════════════════════════════════════════════════════════
# Mode B — @plumbus/ai-bedrock runtime (Converse / InvokeModel + embeddings)
# Leave OPENAI_* empty (or set BEDROCK_SMOKE_MODE=runtime).
# Auth (pick one): AWS_BEARER_TOKEN_BEDROCK (console API key) OR IAM access keys.
# ══════════════════════════════════════════════════════════════════════
# BEDROCK_SMOKE_MODE=runtime
# AI_BEDROCK_REGION=eu-north-1
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# Chat: Nova works without Anthropic use-case form; Claude may require it in console.
# AI_BEDROCK_MODEL=amazon.nova-lite-v1:0
# AI_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# AI_BEDROCK_PRICING_FILE=./lib/pricing.fixture.json
