# Copy to .env and fill in, or export these in your shell.
# `.env` is gitignored; `.env.example` is committed.
#
# The three PLUMBUS_OPENAI_* values are REQUIRED — the app has NO code defaults
# and refuses to run until they are set.

# OpenAI-compatible endpoint. The adapter POSTs to
# `${PLUMBUS_OPENAI_BASE_URL}/chat/completions`, so include the version suffix.
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Ollama:     http://localhost:11434/v1
#   Open WebUI: http://<host>:3000/ollama/v1
PLUMBUS_OPENAI_BASE_URL=

# Sent as `Authorization: Bearer <key>`. A bare Ollama server ignores it (any
# non-empty string works); OpenAI / Open WebUI need a real key.
PLUMBUS_OPENAI_API_KEY=

# Model name as your server exposes it. MUST support native tool calling for the
# tool phase to fire — e.g. qwen2.5, llama3.1, mistral-nemo. No default.
PLUMBUS_OPENAI_MODEL=

# Optional: the user turn to send. A CLI arg (node smoke.mjs "...") overrides it.
# PLUMBUS_CHAT_MESSAGE=What is the weather in Helsinki right now?
