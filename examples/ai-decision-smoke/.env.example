# The runner creates .env and generates LAYA_API_KEY automatically.
# No edits are needed for the default local smoke.
LAYA_API_KEY=replace-only-if-you-want-to-choose-your-own-password
LAYA_BASE_URL=http://127.0.0.1:8080/v1
LAYA_MODEL=english
LAYA_MODELS=english
LAYA_DEVICE=cpu
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
