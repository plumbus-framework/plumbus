# Copy to .env (gitignored) and fill in. Never commit .env.

# Required. Either name works — the adapter accepts both.
AI_TYPESAFE_API_KEY=ts-...
# TYPESAFE_API_KEY=ts-...

# Optional. Pin a version instead of an alias to keep answers stable.
# AI_DECISION_MODEL=jev-1.13.0

# Optional.
# AI_TYPESAFE_BASE_URL=https://api.typesafe.ai
# AI_TYPESAFE_REQUEST_TIMEOUT=30000
