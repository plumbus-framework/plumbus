# Database (scripts/e2e.mjs starts its own Postgres container and sets these)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=payments_connect_app
DB_USER=postgres
DB_PASSWORD=
# JWT auth for the API (>= 32 characters)
AUTH_SECRET=
APP_BASE_URL=http://localhost:3000
# Stripe: a TEST key. Set STRIPE_API_BASE to use the local simulator instead of Stripe.
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRETS=
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_BASE=
