# Copy to .env and edit, or export these in your shell. All are optional —
# the app runs with the defaults below against a cognitox on localhost:9229.
# `.env` is gitignored; `.env.example` is committed.

# Where cognitox's discovery + cognito-idp admin API are reached.
# If cognitox runs on another host, set this to that address AND start cognitox
# with a matching COGNITOX_ISSUER_BASE_URL (e.g. http://192.168.50.87:9229).
COGNITOX_URL=http://localhost:9229

# Target user pool. Leave unset to find/create one named COGNITO_POOL_NAME.
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_POOL_NAME=plumbus-auth-cognito-smoke

# serve.mjs port and the public base URL (drives the callback URL).
PORT=3000
# EXTERNAL_BASE_URL=http://localhost:3000
# APPLICATION_BASE_URL=http://localhost:3000

# Hosted-UI identity_provider allowlist exercised by the cognito() integration.
ALLOWED_IDPS=COGNITO,Google

# Seeded login user (auto-provisioned).
SMOKE_USERNAME=smoke@example.com
SMOKE_PASSWORD=SmokeTest123!
SMOKE_CLIENT_NAME=plumbus-auth-cognito-smoke

# Optional HTTPS hosted-UI domain for federated-logout URL construction.
# PROVIDER_LOGOUT_DOMAIN=https://your-app.auth.us-east-1.amazoncognito.com

# Local nonce proxy (injects the OIDC nonce cognitox omits).
NONCE_PROXY_PORT=9301

# Set 1 to insert a simulated one-time-code challenge mid-login (code printed
# to the terminal). Off by default.
OTP_MODE=0

# Set 0 to skip provisioning and supply your own confidential client instead.
AUTO_PROVISION=1
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
