{
  "name": "@plumbus/ui",
  "version": "0.10.0-beta.2",
  "description": "Plumbus UI — client generation and frontend templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next-intl": {
      "types": "./dist/next-intl/index.d.ts",
      "import": "./dist/next-intl/index.js",
      "default": "./dist/next-intl/index.js"
    },
    "./next-intl-server": {
      "types": "./dist/next-intl-server/index.d.ts",
      "import": "./dist/next-intl-server/index.js",
      "default": "./dist/next-intl-server/index.js"
    }
  },
  "files": [
    "dist",
    "instructions",
    "CHANGELOG.md"
  ],
  "plumbus": {
    "provides": [
      "next",
      "react",
      "react-dom",
      "@types/react",
      "@types/react-dom",
      "tailwindcss",
      "@tailwindcss/postcss",
      "typescript"
    ]
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.config.browser.ts --passWithNoTests",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "typecheck": "tsc --noEmit && node ./scripts/check-catalog-translation-types.mjs",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "plumbus",
    "ui",
    "frontend"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@plumbus/core": ">=0.9.0-beta.6 <0.10.0",
    "next-intl": "^4.9.2"
  },
  "devDependencies": {
    "@plumbus/core": "workspace:*",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.52.0",
    "vitest": "5.0.5"
  }
}
