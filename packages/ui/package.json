{
  "name": "@plumbus/ui",
  "version": "0.2.5",
  "description": "Plumbus UI — client generation and frontend templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next-intl": {
      "types": "./dist/next-intl/index.d.ts",
      "import": "./dist/next-intl/index.js"
    },
    "./next-intl-server": {
      "types": "./dist/next-intl-server/index.d.ts",
      "import": "./dist/next-intl-server/index.js"
    }
  },
  "files": [
    "dist",
    "instructions"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.config.browser.ts --passWithNoTests",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "plumbus",
    "ui",
    "frontend"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@plumbus/core": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.1",
    "next-intl": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@vitest/browser": "^3.0.0",
    "playwright": "^1.52.0",
    "vitest": "^3.0.0"
  }
}
