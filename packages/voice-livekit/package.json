{
  "name": "@plumbus/voice-livekit",
  "version": "0.1.3",
  "description": "LiveKit transport, agent worker, and browser session helpers for @plumbus/voice.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "files": ["dist", "instructions", "README.md", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/voice-livekit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "peerDependencies": {
    "@plumbus/core": "0.6.x",
    "@plumbus/voice": "0.4.x",
    "fastify": "^5.0.0",
    "livekit-client": "^2.0.0",
    "@livekit/krisp-noise-filter": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "livekit-client": {
      "optional": true
    },
    "@livekit/krisp-noise-filter": {
      "optional": true
    }
  },
  "dependencies": {
    "@livekit/agents": "^1.4.6",
    "@livekit/krisp-noise-filter": "^0.4.3",
    "@livekit/noise-cancellation-node": "^0.1.9",
    "@livekit/rtc-node": "^0.13.29",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "livekit-server-sdk": "^2.15.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@plumbus/core": "workspace:*",
    "@plumbus/voice": "workspace:*",
    "fastify": "^5.0.0",
    "livekit-client": "^2.19.2",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
