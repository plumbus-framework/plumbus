{
  "name": "@plumbus/voice-elevenlabs",
  "version": "0.4.0-beta.0",
  "description": "ElevenLabs TTS provider for @plumbus/voice.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "instructions",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/voice-elevenlabs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@plumbus/core": ">=0.9.0-beta.0 <0.10.0",
    "@plumbus/voice": ">=0.7.0-beta.0 <0.8.0"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.59.0"
  },
  "devDependencies": {
    "@plumbus/core": "workspace:*",
    "@plumbus/voice": "workspace:*",
    "vitest": "5.0.4"
  },
  "license": "MIT"
}
