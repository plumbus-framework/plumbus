{
  "name": "@plumbus/core",
  "version": "0.5.0",
  "description": "Plumbus framework core — types, SDK, runtime, CLI, test utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "plumbus": "./bin/plumbus.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./zod": {
      "types": "./dist/zod/index.d.ts",
      "import": "./dist/zod/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "import": "./dist/vitest/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "files": [
    "dist",
    "instructions"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.config.browser.ts",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "plumbus",
    "framework",
    "contract-driven",
    "ai-native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/plumbus-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "commander": "^12.1.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.2",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.52.0",
    "postgres": "^3.4.8",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "xml-crypto": "^6.1.2",
    "xpath": "^0.0.34",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "@plumbus/api": "0.1.x",
    "@plumbus/mcp": "0.5.x",
    "cron-parser": "^4.9.0",
    "redis": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "@plumbus/api": {
      "optional": true
    },
    "@plumbus/mcp": {
      "optional": true
    },
    "cron-parser": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@plumbus/api": "workspace:*",
    "@plumbus/mcp": "workspace:*",
    "@types/node": "^25.4.0",
    "@vitest/browser": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
