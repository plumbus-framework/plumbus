{
  "name": "@plumbus/auth-cognito",
  "version": "0.1.0",
  "description": "Amazon Cognito integration for @plumbus/auth — hosted login options, client auth method, and logout URL builder.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "files": ["dist", "instructions", "README.md", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/auth-cognito"
  },
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=20.6.0" },
  "peerDependencies": {
    "@plumbus/auth": "0.1.x"
  },
  "devDependencies": {
    "@plumbus/auth": "workspace:*",
    "@plumbus/core": "workspace:*",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
