{
  "name": "@plumbus/chat",
  "version": "0.1.0",
  "description": "Plumbus chat primitive — policy, context sources, guards, budgets, evals.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" },
    "./eval": { "types": "./dist/eval/index.d.ts", "default": "./dist/eval/index.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit"
  },
  "files": ["dist", "instructions", "README.md", "CHANGELOG.md"],
  "peerDependencies": {
    "@plumbus/core": "^0.4.0 <0.5.0"
  },
  "devDependencies": {
    "@plumbus/core": "workspace:*",
    "fastify": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "fastify": { "optional": true }
  },
  "license": "MIT"
}
