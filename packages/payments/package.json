{
  "name": "@plumbus/payments",
  "version": "0.2.0",
  "description": "Plumbus payments add-on — provider-neutral payments as Plumbus capabilities, entities, and events: sellers charge their own clients (Connect), and the app bills its own customers for plans, seats, and usage.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "instructions",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "plumbus",
    "payments",
    "connect",
    "marketplace",
    "billing",
    "subscriptions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/payments"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "peerDependencies": {
    "@plumbus/core": "0.7.x",
    "fastify": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@plumbus/core": "workspace:*",
    "@types/node": "^25.4.0",
    "fastify": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
