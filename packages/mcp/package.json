{
  "name": "@plumbus/mcp",
  "version": "0.8.0-beta.1",
  "description": "Plumbus MCP runtime — expose capabilities to AI agents over Model Context Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "instructions",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "lint": "biome lint ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "plumbus",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plumbus-framework/plumbus.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@plumbus/core": ">=0.9.0-beta.5 <0.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@plumbus/core": "workspace:*",
    "@biomejs/biome": "^2.4.6",
    "@types/node": "^25.4.0",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.7.0",
    "vitest": "5.0.4",
    "zod": "^3.24.2"
  }
}
